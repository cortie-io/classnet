{
  "name": "network-tutor-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed:admin": "tsx src/db/seedAdmin.ts",
    "embed:nodes": "tsx src/db/reembedNodes.ts",
    "ingest": "tsx src/ingest/ingest.ts",
