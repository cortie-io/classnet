    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
